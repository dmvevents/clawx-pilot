<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ClawX Windows-native ASR helper.

    Targets .NET Framework 4.8 because System.Speech supports WAV-file input
    through SetInputToWaveFile and is present on stock Windows 11 images.

    Build from the repo root with:

        pnpm run win-asr:build:x64

    Output: WinSpeechRecognize.exe lands at
            resources/bin/win32-x64/WinSpeechRecognize.exe
            which is what asr-native-windows.ts looks for.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>ClawX.WinSpeechRecognize</RootNamespace>
    <AssemblyName>WinSpeechRecognize</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <!-- We build a console executable; no WinForms / WPF / COM hosting. -->
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <EnableComHosting>false</EnableComHosting>

    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Speech" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
