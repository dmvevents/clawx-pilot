{
  "id": "P5-image-fields",
  "tool_called": "document.read_image",
  "result_schema": {
    "content": "array",
    "details": "object"
  },
  "assertions": {
    "details.bytes_min": 1,
    "details.mimeType_matches": "^image/",
    "content.image.mimeType_matches": "^image/",
    "content.image.data_matches": "^iVBOR",
    "content.text_contains": "\"path\""
  }
}
